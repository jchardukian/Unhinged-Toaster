# ---- LLM (one of the two is required for scoring / headlines) ----
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
LLM_PROVIDER=openai            # openai | anthropic
LLM_MODEL=gpt-4o-mini          # or claude-haiku-5-5 when LLM_PROVIDER=anthropic
VISION_OCR_MODEL=gpt-4o        # reads creator handles printed in the footage (two frames must agree); claude-sonnet-5-5 for anthropic

# ---- Captions (Whisper via OpenAI) ----
TRANSCRIBE_MODEL=whisper-1

# ---- Voice ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=           # leave blank to auto-pick the first available voice
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ---- Buffer (Settings > API in publish.buffer.com) ----
BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=6abaf3c8c5df6d1c7b1c9d3c
BUFFER_YOUTUBE_CHANNEL_ID=6ae95257e29c69a17143de1d
BUFFER_TIKTOK_CHANNEL_ID=6ae9500ee29c69a17143c263
BUFFER_TIMEZONE=America/Chicago
# Daily publishing slots, local time, comma separated (3 required)
PUBLISH_SLOTS=11:00,15:00,19:00
# draft (default, works on every plan) | needs_approval (Buffer Team plan approval queue)
BUFFER_APPROVAL_MODE=draft
# Optional internal Buffer tags (never published) to mark drafts in the Buffer UI: create "REVIEW" / "CLEARED" tags once
BUFFER_TAG_REVIEW_ID=
BUFFER_TAG_CLEARED_ID=
# Public credit block contact address (every description)
CONTACT_EMAIL=theunhingedtoaster@gmail.com
# Quality gate: 1080p-class sources required; 720p-class only when 1080p stock runs out; lower is rejected unless
ALLOW_LOW_QUALITY=false
# Mid-clip reaction sticker ("NOPE.", "WHOA.") at the detected peak: off by default
STICKERS=false
# Background music: auto = LLM decides per clip (light bed unless the clip's own audio must stay clean); always | never
MUSIC_DEFAULT=auto
# auto = the LLM decides per clip whether the toaster speaks (outro_voice | text_only | none); always | never override
COMMENTARY_DEFAULT=auto

# ---- Discovery sources ----
YOUTUBE_API_KEY=               # YouTube Data API v3 (creativeCommon license search)
REDDIT_CLIENT_ID=              # "script" type app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=unhinged-toaster/0.1 by u/<your_username>
# Transformation review: footage WITHOUT an explicit license (Reddit, standard-license YouTube) is rendered into a
# transformed short and drafted with a review note for the owner. It is never auto-classified as licensed/cleared.
TRANSFORMATION_REVIEW=true
MAX_COPYRIGHT_RISK=medium       # low | medium ; "high" footage (broadcast/pro/music) is never produced
# YouTube virals without a key or creator handles (ON by default; transformation review). Two kinds of timeframe:
#   alltime = hashtag Shorts shelves (proven: tens/hundreds of millions of views); today/week/month = search filtered by
#   upload date + sorted by views, ranked by views per hour (just went viral / gaining traction). Fetches with yt-dlp.
ENABLE_YOUTUBE_TRANSFORM=true
YOUTUBE_VIRAL_WINDOWS=today,week,month,alltime
# Reddit top-of windows: day = trending now, week/month = proven
REDDIT_WINDOWS=day,week
# TikTok: no server-side discovery exists without handles (tag/search/sound pages are blocked); optional curated
# ORIGINAL-creator handles (no @) are ranked by real views/likes. TikTok virals also arrive via r/TikTokCringe reposts.
TIKTOK_ACCOUNTS=
# yt-dlp: install with  pip install "yt-dlp[default]"  (bundles the JS challenge solver; YouTube downloads 403 without it).
# If a runner IP is bot-walled ("sign in to confirm you're not a bot"), export your browser cookies and/or pin player clients.
YTDLP_YOUTUBE_CLIENTS=          # blank = yt-dlp default clients (worked from a datacenter IP); e.g. android,web
YTDLP_COOKIES_B64=              # base64 of a Netscape-format cookies.txt exported from your browser (optional)
# Automated, commercially reusable sources (free API keys). Used as fillers when set.
PIXABAY_API_KEY=               # https://pixabay.com/api/docs/  (Pixabay Content License)
PEXELS_API_KEY=                # https://www.pexels.com/api/    (Pexels License)
# Internet Archive needs no key (public domain / CC0 / CC BY items).
# YouTube Creative Commons source: OFF by default (CC label is uploader-asserted; yt-dlp vs YouTube ToS). See docs/SOURCES.md
ENABLE_YOUTUBE_CC=false
# Override the automatic source list, e.g. pixabay,pexels,internet_archive,youtube,reddit
# DISCOVERY_SOURCES=

# ---- Storage (Cloudflare R2 via S3 API) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=toaster-media
R2_PUBLIC_BASE_URL=            # e.g. https://media.unhingedtoaster.example or https://pub-xxxx.r2.dev

# ---- Control plane (Cloudflare Worker) ----
TOASTER_API_URL=               # e.g. https://toaster-api.<account>.workers.dev
TOASTER_API_TOKEN=             # shared secret; same value as the Worker's API_TOKEN secret

# ---- Alerts ----
ALERT_WEBHOOK_URL=             # optional Slack/Discord incoming webhook for batch shortages and sync errors

# ---- Local working directories ----
WORK_DIR=./work
