  "watermark": { "logoWidth": 72, "x": 30, "y": 1812, "fontSize": 44, "wordmarkWidth": 330, "wordmarkBottom": 36 },
  "commentary": { "position": "intro", "introDelay": 0.35, "duckVolume": 0.25, "outroSeconds": 3.2, "fontSize": 48, "boxColor": "#FFD400", "textColor": "#111111", "y": 1470, "maxCharsPerLine": 27, "maxLines": 4 },
  "audio": { "musicVolume": 0.10, "musicDuck": 0.35, "voVolume": 1.5, "loudnorm": "I=-14:TP=-1.5:LRA=11" },
  "limits": { "maxDurationSec": 59 }
