{
  "name": "unhinged-toaster",
  "version": "0.1.0",
  "private": true,
  "description": "Automated viral Shorts pipeline for The Unhinged Toaster (YouTube Shorts + TikTok via Buffer)",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/pipeline",
    "packages/worker"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w packages/shared -w packages/pipeline",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "toaster": "node packages/pipeline/dist/cli.js",
    "worker:dev": "npm run dev -w packages/worker",
    "worker:deploy": "npm run deploy -w packages/worker",
    "brand:generate": "node packages/pipeline/dist/cli.js brand:generate",
    "render:demo": "node packages/pipeline/dist/cli.js demo"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "wrangler": "^4.156.2"
  }
}
